{
  "app": {
    "name": "极简排班",
    "slogan": "一个帮助你排班的app",
    "package": "cn.jianyun.workplan",
    "versionName": "3.5.0",
    "versionCode": 36,
    "tech": [
      "Kotlin",
      "Jetpack Compose",
      "Material3",
      "Hilt",
      "Navigation-Compose",
      "Room",
      "DataStore",
      "Glance(AppWidget)"
    ],
    "platform": "Android",
    "sourceOfTruth": "jadx-src (decompiled) + decoded resources"
  },
  "tokens": {
    "colors": {
      "light": {
        "primary": "#000000",
        "secondary": "#222222",
        "tertiary": "#999999",
        "background": "#F6F5F4",
        "onBackground": "#000000",
        "surface": "#FDFDFD",
        "surfaceVariant": "#EEEEEE",
        "error": "#F87679"
      },
      "dark": {
        "primary": "#FFFFFF",
        "secondary": "#DDDDDD",
        "tertiary": "#888888",
        "background": "#191919",
        "surface": "#111111",
        "surfaceVariant": "#222222",
        "error": "#F87679"
      },
      "app": {
        "themeColor": "#55BB8A",
        "primaryColor": "#1974E8",
        "deleteColor": "#F87679",
        "importantColor": "#EE3F4D",
        "vipColor": "#C5A874",
        "privateColor": "#806D9E",
        "gray": "#888888"
      },
      "workDefaultThemeExample": "#55BB8A",
      "todayAccent": "#F87679",
      "selectedDayBg": "rgba(85,187,138,0.20)"
    },
    "typography": {
      "fontFamily": "system",
      "bodyLarge": {
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0.5,
        "weight": 400
      },
      "headerTitle": {
        "fontSize": 16,
        "weight": 700
      },
      "tabItem": {
        "fontSize": 10,
        "weight": 500,
        "lineHeight": 10
      },
      "sectionHint": {
        "fontSize": 12,
        "color": "tertiary"
      },
      "smallTip": {
        "fontSize": 12,
        "color": "gray"
      },
      "version": {
        "fontSize": 12,
        "color": "gray"
      }
    },
    "shape": {
      "card": 10,
      "dayCellBorder": 6,
      "todayNumber": 8,
      "workBlockNormal": 8,
      "workBlockSmall": 3,
      "button": 10,
      "iconCircle": 18
    },
    "spacing": {
      "screenPaddingH": 10,
      "headerHeight": 48,
      "iconButton": 36,
      "navItemVPad": 10,
      "listBottomPad": 80,
      "cardGap": 10
    },
    "iconFont": {
      "family": "remixicon (R.font.remixicon)",
      "codepoints": {
        "home": 60959,
        "sun": 61887,
        "alarm": 59931,
        "stat": 60062,
        "user": 62038,
        "settings": 61668,
        "list": 62361,
        "back": 60000,
        "right2": 59988,
        "arrow_right": 60012,
        "add": 59923,
        "clear": 60313,
        "refresh": 61540,
        "share": 61694,
        "cloud": 60317,
        "cloud2": 62030,
        "cloud3": 62530,
        "download": 60500,
        "vip": 62096,
        "thumb": 61959,
        "image": 61003,
        "palette": 61381,
        "time": 61967,
        "calendar": 60193,
        "alert": 62341,
        "info": 61017,
        "info2": 61801,
        "doc": 61849,
        "folder": 60778,
        "file": 60613,
        "filter": 60711
      }
    },
    "colorPalette": {
      "source": "assets/data/color.json",
      "count": 230,
      "groups": 8,
      "sample": [
        {
          "name": "香叶红",
          "color": "#F07C82"
        },
        {
          "name": "玉红",
          "color": "#C04851"
        },
        {
          "name": "茶花红",
          "color": "#EE3F4D"
        },
        {
          "name": "高粱红",
          "color": "#C02C38"
        }
      ]
    }
  },
  "navigation": {
    "type": "single NavHost + tab state",
    "startDestination": "Home",
    "routes": [
      {
        "key": "Home",
        "screen": "MainView -> ScheduleMainView",
        "title": "主界面",
        "params": []
      },
      {
        "key": "Schedule",
        "screen": "ScheduleMainView",
        "title": "主界面(别名)",
        "params": []
      },
      {
        "key": "ScheduleProjectManage",
        "screen": "ScheduleProjectManagerView",
        "title": "项目管理",
        "container": "PageWithFooterView"
      },
      {
        "key": "ScheduleWorkEdit",
        "screen": "ScheduleWorkEditView",
        "title": "添加班次/编辑班次",
        "params": [
          "model:JSON(ScheduleWork)"
        ]
      },
      {
        "key": "SchedulePlanEdit",
        "screen": "SchedulePlanEditView",
        "title": "添加轮班/编辑轮班",
        "params": [
          "model:JSON(SchedulePlan)"
        ]
      },
      {
        "key": "ScheduleAlarmEdit",
        "screen": "ScheduleAlarmEditView",
        "title": "添加提醒/编辑提醒",
        "params": [
          "model:JSON(ScheduleAlarm)"
        ]
      },
      {
        "key": "ScheduleCloudManage",
        "screen": "ScheduleCloudManageView",
        "title": "备份管理"
      },
      {
        "key": "ScheduleShareData",
        "screen": "ScheduleShareView",
        "title": "分享与导入排班",
        "container": "PageView"
      },
      {
        "key": "Question",
        "screen": "QuestionView",
        "title": "常见问题解答",
        "container": "LazyAppPageView"
      },
      {
        "key": "UserPolicy",
        "screen": "UserPolicy",
        "title": "用户使用协议"
      },
      {
        "key": "PrivatePolicy",
        "screen": "PrivatePolicy",
        "title": "App隐私政策"
      },
      {
        "key": "Wechat",
        "screen": "WechatView",
        "title": "导入微信小程序排班数据",
        "container": "PageView"
      },
      {
        "key": "Widget",
        "screen": "WidgetConfigView",
        "title": "桌面小组件",
        "container": "PageView"
      },
      {
        "key": "UserDetail",
        "screen": "UserDetailView",
        "title": "我的信息",
        "container": "PageView"
      },
      {
        "key": "WebDAV",
        "screen": "WebDavDataView",
        "title": "我的文件",
        "container": "PageView"
      },
      {
        "key": "WebDAVManage",
        "screen": "WebDAVUserManageView",
        "title": "云备份账号",
        "container": "PageView"
      },
      {
        "key": "WebDAVUserEdit",
        "screen": "WebDAVUserEditView",
        "title": "添加/编辑云备份",
        "container": "PageView"
      },
      {
        "key": "LocalBackup",
        "screen": "LocalBackupView",
        "title": "本地备份",
        "container": "PageView"
      },
      {
        "key": "NotifySetting",
        "screen": "NotifySettingView",
        "title": "通知权限设置",
        "container": "PageView"
      },
      {
        "key": "Vip",
        "screen": "VipPage",
        "title": "会员",
        "container": "FullDialog"
      }
    ],
    "tabs": [
      {
        "id": "home",
        "label": "排班",
        "icon": "home"
      },
      {
        "id": "work",
        "label": "班次",
        "icon": "sun"
      },
      {
        "id": "alarm",
        "label": "提醒",
        "icon": "alarm"
      },
      {
        "id": "stat",
        "label": "统计",
        "icon": "stat"
      },
      {
        "id": "self",
        "label": "我的",
        "icon": "user"
      }
    ],
    "deepLinks": [
      {
        "type": "intent-extra",
        "name": "target_route",
        "sender": "桌面小组件点击",
        "target": "Widget"
      }
    ],
    "backBehavior": "push 页由 PageView 内 BackHandler popBackStack；Tab 页不拦截返回（退出 App）"
  },
  "components": {
    "pageContainers": {
      "PageView": "返回箭头+居中标题+scroll 内容+padding h10",
      "LazyAppPageView": "同 PageView，LazyColumn",
      "SimpleSubAppPageView": "48dp 头部+居中标题+scroll，无返回",
      "PageWithFooterView": "PageView+底部固定按钮区",
      "SelfHeaderView": "48dp 自定义头部"
    },
    "header": {
      "height": 48,
      "titleFontSize": 16,
      "titleWeight": 700,
      "titleColor": "primary",
      "backIcon": "back(60000)",
      "backButtonSize": 36,
      "iconFontSize": 20
    },
    "bottomNav": {
      "background": "background",
      "itemIconSize": 20,
      "itemFontSize": 10,
      "itemFontWeight": 500,
      "selectedColor": "#55BB8A",
      "unselectedColor": "#888888",
      "itemPaddingV": 10
    },
    "cards": {
      "GroupView": {
        "radius": 10,
        "background": "surface",
        "selectedVariant": "surfaceVariant",
        "selectedBorder": "2dp themeColor",
        "gap": 10
      },
      "SettingGroupView": "设置分组卡",
      "GroupTitleView": "小节标题+卡片",
      "CenterGroupView": "居中预览卡",
      "ZeroGroupView": "无内边距卡"
    },
    "formItems": [
      "LabelItemView",
      "ShownItemView",
      "ValueItemView",
      "ColorValueItemView",
      "LinkItemView",
      "InputItemView",
      "InnerInputItemView",
      "InputNumberView",
      "AdderView",
      "FloatAdderView",
      "SwitchItemView",
      "SelectItemView",
      "MultiSelectItemView",
      "SegmentItemView",
      "SegmentPickerView",
      "TimePickerItemView3",
      "TimePeriodPickerItemView3",
      "DatePickerItemView",
      "LunarDatePickerItemView",
      "DoublePickerItemView",
      "ColorSelectItemView",
      "RepeatConfigItemView",
      "SheetButtonView",
      "FlowTagView",
      "TagView"
    ],
    "buttons": {
      "LongOkButton": {
        "bg": "#55BB8A",
        "text": "#FFFFFF",
        "height": 50,
        "radius": 10,
        "font": 16
      },
      "LongCancelButton": {
        "bg": "surface",
        "text": "primary",
        "height": 50,
        "radius": 10
      },
      "LongDeleteButton": {
        "text": "#F87679",
        "bg": "surface"
      },
      "LongPrivateButton": {
        "bg": "#806D9E",
        "text": "#FFFFFF"
      },
      "LongVipButton": {
        "bg": "#C5A874",
        "text": "#FFFFFF"
      }
    },
    "dialogs": [
      "SelfDialog",
      "FullDialog",
      "TipDialog",
      "ConfirmDialog",
      "DeleteDialog",
      "LoadingDialog",
      "SheetDialog",
      "SortDialogView",
      "WeekChooseDialog",
      "WelcomeDialog",
      "UpdateIntroDialog",
      "BottomDialogView",
      "BottomSheetDialog",
      "ShowInputDialog"
    ],
    "charts": {
      "PieGraph": {
        "height": 280,
        "impl": "razerdp AnimatedPieView",
        "legend": "12dp color chip + name"
      }
    }
  },
  "screens": [
    {
      "id": "screen-01-home",
      "route": "Home",
      "tab": "排班",
      "title": "排班首页",
      "blocks": [
        {
          "id": "header",
          "type": "row",
          "height": 48,
          "children": [
            {
              "type": "monthTitle",
              "text": "yyyy年MM月",
              "fontSize": 18,
              "color": "#55BB8A",
              "action": "openMonthPicker"
            },
            {
              "type": "rightIcons",
              "children": [
                {
                  "type": "smallButton",
                  "text": "去广告",
                  "visibleWhen": "showPurchase && !isAdVip",
                  "action": "vip"
                },
                {
                  "type": "headerIcon",
                  "icon": "list",
                  "action": "chooseProject"
                },
                {
                  "type": "headerIcon",
                  "icon": "settings",
                  "action": "config"
                }
              ]
            }
          ]
        },
        {
          "id": "notice",
          "type": "banner",
          "visibleWhen": "appTip.show && showTip",
          "text": "温馨提示:{message}",
          "fontSize": 12,
          "close": "×",
          "color": "appTip.showColor"
        },
        {
          "id": "stats",
          "type": "hscroll",
          "visibleWhen": "config.showStat",
          "item": {
            "chip": {
              "w": 10,
              "h": 10,
              "radius": 4,
              "color": "item.color"
            },
            "text": "{name}({value})",
            "fontSize": 12
          },
          "emptyText": "当前月份没有设置排班"
        },
        {
          "id": "configHint",
          "type": "banner",
          "visibleWhen": "showConfigHint",
          "text": "温馨提示:点击右上角设置按钮，可以设置日历字号大小、显示农历等个性化选项",
          "fontSize": 12,
          "color": "#999999",
          "close": "×"
        },
        {
          "id": "calendar",
          "ref": "screen-02-calendar"
        },
        {
          "id": "dutySection",
          "type": "group",
          "title": "{yyyy-MM-dd}班次",
          "children": [
            {
              "type": "workBlock",
              "ref": "wholeWorkItem",
              "action": "chooseFirstWork"
            },
            {
              "type": "workBlock",
              "ref": "wholeWorkItem",
              "visibleWhen": "secondWork.name !== ''",
              "action": "chooseSecondWork"
            }
          ]
        },
        {
          "id": "remarkSection",
          "type": "group",
          "visibleWhen": "duty.remark !== ''",
          "title": "{yyyy-MM-dd}备注",
          "children": [
            {
              "type": "smallTipText",
              "action": "showRemark"
            }
          ]
        },
        {
          "id": "actions",
          "type": "footer",
          "variants": [
            {
              "when": "duty.isAdd",
              "buttons": [
                {
                  "text": "{homeEdit?'完成排班':'开启排班'}",
                  "style": "LongCancelButton",
                  "action": "toggleEdit"
                }
              ]
            },
            {
              "when": "!duty.isAdd",
              "buttons": [
                {
                  "text": "设置备注"
                },
                {
                  "text": "{homeEdit?'完成排班':'开启排班'}"
                },
                {
                  "text": "第二班次"
                }
              ]
            }
          ]
        }
      ],
      "overlays": [
        {
          "id": "oper-sheet",
          "ref": "screen-03-oper-sheet",
          "when": "homeEdit"
        },
        {
          "id": "config-sheet",
          "ref": "screen-04-config",
          "when": "formType==config"
        },
        {
          "id": "project-sheet",
          "title": "选择排班项目",
          "height": 500,
          "when": "formType==chooseProject"
        },
        {
          "id": "work1-sheet",
          "title": "选择第一班次",
          "height": 500,
          "when": "formType==chooseFirstWork"
        },
        {
          "id": "work2-sheet",
          "title": "选择第二班次",
          "height": 500,
          "when": "formType==chooseSecondWork",
          "firstItem": "取消第二班次"
        },
        {
          "id": "remark-input",
          "type": "ShowInputDialog",
          "when": "formType==showRemark"
        },
        {
          "id": "month-picker",
          "title": "选择月份",
          "height": 300
        }
      ],
      "copy": {
        "emptyMonth": "当前月份没有设置排班",
        "configHint": "温馨提示:点击右上角设置按钮，可以设置日历字号大小、显示农历等个性化选项",
        "finishDuty": "完成排班",
        "startDuty": "开启排班",
        "remark": "设置备注",
        "secondWork": "第二班次"
      }
    },
    {
      "id": "screen-02-calendar",
      "ref": "component",
      "title": "日历组件",
      "spec": {
        "weekdayRow": {
          "labelsMondayFirst": [
            "周一",
            "周二",
            "周三",
            "周四",
            "周五",
            "周六",
            "周日"
          ],
          "fontSize": 12,
          "color": "#888888",
          "weight": 400
        },
        "dayCell": {
          "grid": "7 列，按周分组，行高 IntrinsicSize.Min",
          "container": {
            "weight": 1,
            "paddingV": 3,
            "radiusClip": 4,
            "background": {
              "normal": "surface",
              "selected": "rgba(85,187,138,0.20)"
            },
            "border": {
              "width": 1,
              "color": {
                "normal": "surface",
                "selected": "#55BB8A"
              },
              "radius": 6
            }
          },
          "numberBox": {
            "minWidth": {
              "withLunarOrFestival": 46,
              "else": 40
            },
            "heightByDateFontSize": {
              ">=24": 34,
              ">=20": 30,
              "else": 26
            },
            "radius": 8,
            "backgroundToday": "rgba(247,118,121,0.08)",
            "textColor": {
              "today": "#F87679",
              "normal": "secondary"
            },
            "weight": {
              "today": 700,
              "normal": 500
            },
            "textAlign": "center"
          },
          "lunar": {
            "fontSize": 8,
            "lineHeight": 8,
            "vertical": true,
            "paddingTop": 1,
            "color": {
              "holiday": "#55BB8A",
              "work": "#1974E8",
              "else": "#888888"
            }
          },
          "rowMinHeightByDateFontSize": {
            ">=24": 42,
            ">=20": 38,
            "else": 36
          },
          "workBlocks": {
            "size": "small",
            "radius": "config.workRadius(4)",
            "paddingH": 3,
            "paddingV": 2,
            "fontSize": "config.workFontSize(11)",
            "textColor": "#FFFFFF",
            "maxCount": 2,
            "gap": 2
          },
          "remark": {
            "fontSize": 8,
            "color": "#888888"
          }
        },
        "divider": {
          "visibleWhen": "config.showHLine",
          "spec": "Blank 5 + 1dp #EEEEEE + Blank 5",
          "else": "Blank 10"
        },
        "watermark": {
          "text": "{大写的月份}月",
          "fontSize": 80,
          "color": "rgba(136,136,136,0.10)",
          "align": "center"
        },
        "paging": {
          "type": "HorizontalPager(LazyRow infinite+snap)",
          "dragThresholdPx": 80
        },
        "bottomNav": {
          "items": [
            {
              "icon": "back",
              "text": "上个月",
              "color": "#888888"
            },
            {
              "text": "今天",
              "size": {
                "w": 60,
                "h": 30
              },
              "fontSize": 12,
              "color": "#F87679",
              "visibleWhen": "currentDate != today"
            },
            {
              "text": "下个月",
              "icon": "arrow_right",
              "color": "#888888"
            }
          ]
        },
        "configFields": [
          "dateFontSize=17",
          "workFontSize=11",
          "timeFontSize=11",
          "workRadius=4",
          "showLunar=true",
          "showFestival=true",
          "showBeginTime=false",
          "showEndTime=false",
          "showRemark=false",
          "showStat=true",
          "showHLine=true",
          "beginDay=monday"
        ]
      }
    },
    {
      "id": "screen-03-oper-sheet",
      "ref": "component",
      "title": "排班操作面板",
      "spec": {
        "container": "BottomSheetDialog",
        "headerTabs": [
          "自定义排班",
          "周期轮班",
          "清除",
          "上一天",
          "下一天",
          "关闭"
        ],
        "contentHeight": {
          "self": 200,
          "else": 300
        },
        "contentBg": "surfaceVariant",
        "emptyPlan": "你还没有设置周期排班喔",
        "planDaysInput": {
          "label": "周期轮班天数",
          "default": "90",
          "unit": "天",
          "quick": [
            "30",
            "60",
            "90",
            "180",
            "365"
          ]
        },
        "buttons": {
          "clear": "清空从{date}开始的{N}天排班",
          "add": "添加周期轮班",
          "confirmAdd": "使用此轮班"
        },
        "toast": "不要太着急了"
      }
    },
    {
      "id": "screen-04-config",
      "ref": "component",
      "title": "日历显示设置",
      "spec": {
        "container": "BottomDialogView(title='日历显示设置')",
        "header": [
          "取消",
          "保存"
        ],
        "fields": [
          {
            "label": "一周开始日",
            "type": "segment",
            "options": [
              "周一",
              "周日"
            ],
            "value": "周一"
          },
          {
            "label": "日期字号",
            "type": "select",
            "range": [
              8,
              30
            ],
            "value": 17
          },
          {
            "label": "班次字号",
            "type": "select",
            "range": [
              8,
              30
            ],
            "value": 11
          },
          {
            "label": "时间字号",
            "type": "select",
            "range": [
              8,
              30
            ],
            "value": 11
          },
          {
            "label": "班次圆角",
            "type": "select",
            "range": [
              0,
              10
            ],
            "value": 4
          },
          {
            "label": "显示中国农历",
            "type": "switch",
            "value": true
          },
          {
            "label": "显示中国节假日",
            "type": "switch",
            "value": true
          },
          {
            "label": "显示上班时间",
            "type": "switch",
            "value": false
          },
          {
            "label": "显示下班时间",
            "type": "switch",
            "value": false
          },
          {
            "label": "显示备注",
            "type": "switch",
            "value": false
          },
          {
            "label": "显示统计指标",
            "type": "switch",
            "value": true
          },
          {
            "label": "显示分割线",
            "type": "switch",
            "value": true
          }
        ]
      }
    },
    {
      "id": "screen-05-work",
      "route": "work tab + ScheduleWorkEdit",
