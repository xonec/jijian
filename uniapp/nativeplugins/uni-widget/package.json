{
  "name": "uni-widget",
  "id": "uni-widget",
  "version": "1.0.0",
  "description": "极简排班（复刻）桌面小组件：月历 + 班次（读取 App 写入的 SharedPreferences）",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "integrateType": "aar",
      "minSdkVersion": 26,
      "abis": [
        "armeabi-v7a",
        "arm64-v8a"
      ],
      "plugins": [
        {
          "type": "module",
          "name": "uni-widget",
          "class": "cn.jianyun.replica.widget.WidgetModule"
        }
      ]
    }
  }
}
